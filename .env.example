# App
JWT_SECRET=

# MariaDB (필수. 기본값 없음)
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=eventhorizon
# AWS RDS 는 true. 로컬 MariaDB 는 false
DB_SSL=false
# RDS 인증서 검증을 끄려면 false (권장하지 않음)
# DB_SSL_REJECT_UNAUTHORIZED=true

# 최초 관리자 1명 생성 (npm run seed:users)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=관리자

# MQTT (임계값 알림, 선택)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_ALERTS=eventhorizon/alerts
MQTT_ENABLED=false

# 센서 임계값 (기울기 기본값, 장비별 설정이 있으면 그걸 우선)
THRESHOLD_TILT_DEG=5
THRESHOLD_TEMP_C=45
THRESHOLD_BATTERY=15

# Kakao Map — Docker/ECS 이미지는 빌드 시 ARG 로 넣어야 한다 (런타임 env 만으로는 안 들어감)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
NEXT_PUBLIC_APP_NAME=EventHorizon
